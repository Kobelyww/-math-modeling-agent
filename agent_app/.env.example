# Active LLM provider: deepseek or mimo
LLM_PROVIDER=deepseek

# ===== DeepSeek provider =====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Mimo provider (OpenAI-compatible API) =====
MIMO_API_KEY=sk-your-mimo-api-key
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_VISION_MODEL=mimo-v2.5

# Aliyun Bailian embedding for RAG semantic retrieval.
# If omitted, EMBEDDING_API_KEY falls back to the active provider API key.
EMBEDDING_API_KEY=sk-your-bailian-api-key

# ===== Optional LLM settings =====
# DEEPSEEK_TEMPERATURE=0.3
# DEEPSEEK_MAX_RETRIES=3
# DEEPSEEK_RETRY_DELAY=1.0
# DEEPSEEK_MAX_TOKENS=0

# Per-agent tuning.
# DEEPSEEK_DATA_ENGINEER_TEMPERATURE=0.1
# DEEPSEEK_MODELER_TEMPERATURE=0.3
# DEEPSEEK_PROGRAMMER_TEMPERATURE=0.2
# DEEPSEEK_CODE_DEBUGGER_TEMPERATURE=0.1
# DEEPSEEK_WRITER_TEMPERATURE=0.4
# DEEPSEEK_REVIEWER_TEMPERATURE=0.2
# DEEPSEEK_SYNTHESIZER_TEMPERATURE=0.3

# Per-agent token limits. 0 means model default.
# DEEPSEEK_DATA_ENGINEER_MAX_TOKENS=0
# DEEPSEEK_MODELER_MAX_TOKENS=0
# DEEPSEEK_PROGRAMMER_MAX_TOKENS=0
# DEEPSEEK_CODE_DEBUGGER_MAX_TOKENS=0
# DEEPSEEK_WRITER_MAX_TOKENS=0
# DEEPSEEK_REVIEWER_MAX_TOKENS=0
# DEEPSEEK_SYNTHESIZER_MAX_TOKENS=0

# ===== Tool/runtime settings =====
# TOOL_TIMEOUT=30
# SANDBOX_MEMORY_MB=512

# ===== Redis Stack memory backend =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-secure
REDIS_DB=0
